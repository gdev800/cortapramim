{
  "name": "cortapramim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plano de corte para marcenaria: otimiza chapas de MDF, reaproveita sobras e gera etiquetas, PDFs e orçamento.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/melhorias/unit/*.test.js\"",
    "test:e2e": "node --test --test-timeout=600000 \"tests/e2e/*.test.js\" \"tests/melhorias/e2e/*.test.js\"",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "test:rls": "bash supabase/tests/run-local.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.5.31",
    "playwright": "^1.50.0",
    "xlsx": "0.18.5"
  }
}
